    N_usb_power -- "5V ↔ vcc" --> N_servo_trigger
    N_usb_power -- "5V ↔ vcc" --> N_hcsr04
    N_usb_power -- "5V ↔ pos" --> N_capacitor
    N_usb_power -- "5V ↔ pos" --> N_resistor
    N_usb_power -- "GND ↔ gnd" --> N_servo_pan
    N_usb_power -- "GND ↔ gnd" --> N_servo_tilt
    N_usb_power -- "GND ↔ gnd" --> N_servo_trigger
    N_usb_power -- "GND ↔ gnd" --> N_hcsr04
